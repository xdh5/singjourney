ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
FROM ${PYTHON_IMAGE}

ARG GENERALUSER_COMMIT=684543d5e5efaef08d02be50dcda8d552478fa60

WORKDIR /workspace

RUN sed -i 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g; s|http://deb.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends ca-certificates curl ffmpeg fluidsynth \
    && rm -rf /var/lib/apt/lists/*

COPY server/requirements.txt /tmp/server-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install mido==1.3.3

RUN curl --fail --location --retry 3 \
      "https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/${GENERALUSER_COMMIT}/GeneralUser-GS.sf2" \
      --output /opt/GeneralUser-GS.sf2 \
    && curl --fail --location --retry 3 \
      "https://raw.githubusercontent.com/mrbumpy409/GeneralUser-GS/${GENERALUSER_COMMIT}/documentation/LICENSE.txt" \
      --output /opt/GeneralUser-GS-LICENSE.txt

COPY server/app /workspace/server/app
ENV PYTHONPATH=/workspace/server

CMD ["python", "-m", "app.jobs.render_practice_assets", "--output", "/output", "--soundfont", "/opt/GeneralUser-GS.sf2"]
