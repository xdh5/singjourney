{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singjourney",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "singjourney.com", "custom_domain": true }, { "pattern": "www.singjourney.com", "custom_domain": true }],
  "account_id": "6c9ea4b716d00c55c0afbcc94c4d95a8",
  "d1_databases": [{ "binding": "DB", "database_name": "singjourney", "database_id": "1536ec02-cbb3-40d2-bcfc-cf46bd18bcbf" }],
  "assets": { "directory": "public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/health/*", "/version"] },
  "observability": { "enabled": true },
  "vars": { "AUTH_SESSION_DAYS": "30", "CORS_ORIGINS": "https://singjourney.com" }
}
