discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "singjourney_services" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "singjourney" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.singjourney_services.output
  labels     = {
    environment = "production",
    product     = "singjourney",
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USERNAME")
      password = sys.env("GRAFANA_LOKI_TOKEN")
    }
  }
}
