.page { min-height: 100vh; padding: 80rpx 28rpx 40rpx; box-sizing: border-box; background: #fff; }.header { display: flex; flex-direction: column; margin-bottom: 48rpx; }.brand { color: #627083; font-size: 24rpx; font-weight: 800; letter-spacing: 5rpx; }.title { margin-top: 8rpx; font-size: 48rpx; font-weight: 900; }.subtitle { margin-top: 12rpx; color: #66758a; font-size: 27rpx; }.card { display: flex; width: 100%; min-height: 144rpx; align-items: center; gap: 24rpx; margin: 20rpx 0; padding: 20rpx 26rpx; border: 1px solid #dce5ef; border-radius: 24rpx; color: #172033; background: #f8fafc; text-align: left; }.card.primary { border-color: #ffc43d; background: #fff9e8; }.icon { display: flex; width: 82rpx; height: 82rpx; align-items: center; justify-content: center; border-radius: 50%; background: #ffc43d; }.copy { display: flex; flex: 1; flex-direction: column; font-size: 32rpx; font-weight: 800; }.small { margin-top: 8rpx; color: #66758a; font-size: 24rpx; font-weight: 400; }.privacy { display: block; margin-top: 54rpx; color: #8290a2; font-size: 24rpx; text-align: center; }
