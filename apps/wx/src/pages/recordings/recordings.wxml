<view class="page">
  <view class="note">录音仅保存在当前微信，清理小程序数据会删除全部内容。</view>
  <view wx:if="{{items.length === 0}}" class="empty"><text>还没有录音</text><button bindtap="goRecord">开始自由录音</button></view>
  <view wx:for="{{items}}" wx:key="id" class="row">
    <view class="play" data-path="{{item.audioPath}}" data-id="{{item.id}}" bindtap="togglePlay">
      <text class="play-icon">{{playingId === item.id ? 'Ⅱ' : '▶'}}</text>
      <view class="copy"><text>{{item.name}}</text><text class="small">{{item.dateLabel}} · {{item.pointCount}} 个音高点</text></view>
      <text class="duration">{{item.durationLabel}}</text>
    </view>
    <button class="delete" data-id="{{item.id}}" bindtap="remove">删除</button>
  </view>
</view>
