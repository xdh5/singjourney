.page { min-height: 100vh; padding: 24rpx 28rpx 50rpx; box-sizing: border-box; background: #fff; }.note { margin-bottom: 22rpx; padding: 20rpx 22rpx; border-radius: 16rpx; color: #66758a; background: #f4f7fb; font-size: 24rpx; line-height: 1.45; }.row { display: flex; min-height: 126rpx; align-items: center; border-bottom: 1px solid #edf1f5; }.play { display: flex; flex: 1; min-width: 0; align-items: center; gap: 18rpx; }.play-icon { width: 42rpx; color: #f59f00; }.copy { display: flex; flex: 1; min-width: 0; flex-direction: column; font-size: 29rpx; font-weight: 700; }.small { margin-top: 6rpx; overflow: hidden; color: #66758a; font-size: 22rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }.duration { color: #66758a; font-size: 24rpx; }.delete { width: 92rpx; margin: 0 0 0 16rpx; padding: 0; color: #dc2626; background: #fff; font-size: 23rpx; }.empty { display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding-top: 180rpx; color: #8a97a7; }.empty button { color: #172033; font-size: 27rpx; text-decoration: underline; background: transparent; }
