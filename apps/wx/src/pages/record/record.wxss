.page { height: 100vh; overflow: hidden; background: #fff; }.board-scroll { height: calc(100vh - 150rpx); }.pitch-canvas { display: block; background: #fff; }.time-bar { display: flex; height: 38rpx; align-items: center; justify-content: center; background: #5f6670; color: #fff; font-size: 23rpx; font-variant-numeric: tabular-nums; }.toolbar { display: flex; height: 112rpx; align-items: center; justify-content: center; gap: 28rpx; padding-bottom: env(safe-area-inset-bottom); border-top: 1px solid #dde5ef; background: #fff; box-sizing: content-box; }.tool { display: flex; width: 112rpx; height: 66rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border: 1px solid #d6dfeb; border-radius: 999rpx; color: #3d4856; background: #fff; font-size: 25rpx; }.tool.primary { border-color: #ffc43d; color: #172033; background: #ffc43d; font-weight: 800; }.tool[disabled] { opacity: .4; }
