{
  "name": "singjourney",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "client",
    "packages/*"
  ],
  "overrides": {
    "vue": "3.4.21",
    "@vue/reactivity": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "@vue/server-renderer": "3.4.21",
    "@vue/shared": "3.4.21"
  },
  "scripts": {
    "dev:client:wx": "npm run dev:mp-weixin -w @singjourney/client",
    "build:core": "npm run build -w @singjourney/pitch-core && npm run build -w @singjourney/curve-layout && npm run build -w @singjourney/contracts",
    "build:client:wx": "npm run build:core && npm run build:mp-weixin -w @singjourney/client",
    "build:client": "npm run build:client:wx",
    "build": "npm run build:client",
    "typecheck": "npm run typecheck -w @singjourney/client",
    "lint": "npm run lint -w @singjourney/client",
    "lint:fix": "npm run lint:fix -w @singjourney/client",
    "format": "npm run format -w @singjourney/client",
    "format:check": "npm run format:check -w @singjourney/client"
  },
  "devDependencies": {
    "@vue/runtime-core": "3.4.21",
    "typescript": "^5.3.3",
    "vue": "3.4.21",
    "vue-tsc": "^3.3.7"
  }
}
