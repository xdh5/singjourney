ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
FROM ${PYTHON_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN groupadd --gid 10001 shengji \
    && useradd --uid 10001 --gid shengji --no-create-home shengji \
    && mkdir -p /data/media \
    && chown -R shengji:shengji /data

COPY server/requirements.txt ./requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

COPY server/app ./app
COPY server/migrations ./migrations
COPY server/alembic.ini ./alembic.ini
COPY release/versions.json ./release/versions.json

USER shengji

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
