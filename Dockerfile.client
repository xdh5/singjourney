FROM node:22-bookworm-slim AS build

WORKDIR /workspace

COPY package.json package-lock.json .npmrc ./
COPY release/versions.json release/versions.json
COPY scripts/release-version.mjs scripts/release-version.mjs
COPY client/package.json client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/curve-layout/package.json packages/curve-layout/package.json
COPY packages/pitch-core/package.json packages/pitch-core/package.json

RUN --mount=type=cache,target=/root/.npm \
    npm ci \
      --registry=https://registry.npmjs.org \
      --replace-registry-host=always \
      --maxsockets=3 \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=2000 \
      --fetch-retry-maxtimeout=30000

COPY client client
COPY packages packages

ARG CLIENT_BUILD_SCRIPT=build:client
ARG CLIENT_RUN_CHECKS=false
ARG CLIENT_RELEASE_COMPONENT=
ARG CLIENT_RELEASE_TAG=
ARG CLIENT_RELEASE_VERSION=0.0.0-dev
ENV VITE_RELEASE_COMPONENT=${CLIENT_RELEASE_COMPONENT} \
    VITE_RELEASE_VERSION=${CLIENT_RELEASE_VERSION}
RUN if [ -n "$CLIENT_RELEASE_COMPONENT" ] && { [ "$CLIENT_RELEASE_COMPONENT" = "ios" ] || [ "$CLIENT_RELEASE_COMPONENT" = "android" ]; }; then \
      npm run version:prepare-client -- "$CLIENT_RELEASE_COMPONENT" "$CLIENT_RELEASE_TAG"; \
    fi \
    && if [ "$CLIENT_RUN_CHECKS" = "true" ]; then npm run build:core && npm run typecheck && npm test; fi \
    && npm run "$CLIENT_BUILD_SCRIPT"

FROM scratch AS web-artifact

COPY --from=build /workspace/client/dist/build/h5 /

FROM scratch AS wx-artifact

COPY --from=build /workspace/client/dist/build/mp-weixin /

FROM scratch AS ios-artifact

COPY --from=build /workspace/client/dist/build/ios /

FROM scratch AS android-artifact

COPY --from=build /workspace/client/dist/build/android /

FROM alpine:3.21 AS artifact

COPY --from=build /workspace/client/dist/build /artifact

CMD ["sh", "-c", "find /output -mindepth 1 -depth -delete && cp -Rf /artifact/. /output/"]
