{
  "pages": [
    {
      "path": "pages/home/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "%home.appTitle%" }
    },
    {
      "path": "pages/profile/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "%nav.profile%" }
    },
    {
      "path": "pages/record/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "%home.appTitle%", "disableScroll": true }
    },
    {
      "path": "pages/recordings/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "%nav.recordings%" }
    },
    {
      "path": "pages/practice/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "%nav.practice%" }
    },
    {
      "path": "pages/practice-recordings/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "%nav.practiceRecordings%" }
    },
    {
      "path": "pages/practice-stats/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "%nav.practiceStats%" }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "%nav.home%",
    "navigationBarBackgroundColor": "#356b5b",
    "backgroundColor": "#ffffff"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  }
}
