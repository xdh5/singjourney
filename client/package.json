{
  "name": "@singjourney/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "npm run build:pitch-worker && uni -p mp-weixin",
    "build:h5": "uni build",
    "build:pitch-worker": "node scripts/build-pitch-worker.mjs",
    "build:mp-weixin": "npm run build:pitch-worker && uni build -p mp-weixin",
    "build:ios": "uni build -p app-plus && node scripts/finalize-native-build.mjs ios app",
    "build:android": "uni build -p app-plus && node scripts/finalize-native-build.mjs android app",
    "finalize:harmony": "node scripts/finalize-native-build.mjs harmony app-harmony",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-app-plus": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "@singjourney/contracts": "*",
    "@singjourney/curve-layout": "*",
    "@singjourney/pitch-core": "*",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9",
    "vue-router": "4.4.4"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5010520260709002",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@vue/runtime-core": "^3.4.21",
    "typescript": "^5.3.3",
    "vite": "^5.2.8",
    "vue-tsc": "^3.3.7"
  }
}
