FROM python:3.12-slim AS scores
WORKDIR /source/server
COPY server/practice ./practice
COPY server/package.json server/generate-scores.py ./
RUN mkdir /output && PYTHONPATH=/source/server python generate-scores.py

FROM node:22-slim AS tools
WORKDIR /workspace/server
COPY server/package.json server/package-lock.json ./
RUN npm ci

FROM tools AS api
COPY server/src/index.js ./src/index.js
COPY --from=scores /output/generated.json ./src/generated.json
COPY server/wrangler.jsonc ./
CMD ["npm", "run", "build"]
