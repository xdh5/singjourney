FROM node:22-bookworm-slim AS dependencies
WORKDIR /workspace
COPY package.json package-lock.json .npmrc ./
COPY client/package.json client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/curve-layout/package.json packages/curve-layout/package.json
COPY packages/pitch-core/package.json packages/pitch-core/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --registry=https://registry.npmmirror.com --replace-registry-host=always --maxsockets=3 --fetch-retries=5

FROM dependencies AS source
COPY client client
COPY packages packages

FROM source AS quality
CMD ["npm", "run", "lint", "-w", "@singjourney/client"]

FROM source AS build
ARG MINI_PROGRAM_APP_ID=touristappid
ARG API_BASE_URL=https://singjourney.com/api/v1
ENV VITE_RELEASE_COMPONENT=wx VITE_API_BASE_URL=${API_BASE_URL} SINGJOURNEY_MINI_PROGRAM_APP_ID=${MINI_PROGRAM_APP_ID}
RUN npm run build:client:wx

FROM scratch AS wx-artifact
COPY --from=build /workspace/client/dist/build/mp-weixin /

FROM alpine:3.21 AS wx-output
COPY --from=build /workspace/client/dist/build/mp-weixin /artifact
CMD ["sh", "-c", "find /output -mindepth 1 -depth -delete && cp -Rf /artifact/. /output/"]
