FROM python:3.12-slim AS scores
WORKDIR /source
COPY server/app ./server/app
COPY server/pyproject.toml ./server/pyproject.toml
COPY cloudflare/generate-scores.py ./generate-scores.py
RUN mkdir /output && PYTHONPATH=/source/server python generate-scores.py

FROM node:22-slim AS tools
WORKDIR /workspace/cloudflare
COPY cloudflare/package.json cloudflare/package-lock.json ./
RUN npm ci

FROM tools AS web
COPY cloudflare/wrangler.web.jsonc ./
COPY client/dist/h5/ ./web-public/
CMD ["npx", "wrangler", "deploy", "--config", "wrangler.web.jsonc"]

FROM tools AS api
COPY cloudflare/src/index.js ./src/index.js
COPY --from=scores /output/generated.json ./src/generated.json
COPY cloudflare/wrangler.jsonc ./
CMD ["npm", "run", "build"]
